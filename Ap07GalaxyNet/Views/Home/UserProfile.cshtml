@using System.Security.Claims
@model Ap07GalaxyNet.Data.AppUser

@{
    ViewData["Title"] = "User";
}
<h2>Benutzerprofil von @Model.Username</h2>
<div class="row">
    <div class="col">
        <img src="@Model.ImagePath" />
    </div>
    <div class="col">
        Beiträge gepostet: @Model.Posts.Count() <br />
        Empfehlungen erhalten: @Model.Posts.Sum(p => p.Likes.Count()) <br />
        Empfehlungen vergeben: @Model.Likes.Count() <br />
    </div>
</div>

<h3>Die letzten 5 Beiträge</h3>

@foreach (var post in Model.Posts.OrderByDescending(p => p.PostedOn).Take(5))
{
    <b>Am @post.PostedOn: <a data-bs-toggle="collapse" href="#post-@post.Id" @* href="/Home/Post?postId=@post.Id" *@>@post.Title</a> (@post.Likes.Count() Empfehlungen)</b>
    <div class="collapse" id="post-@post.Id">
        @post.Content 
    </div>
    @if (User.Identity.IsAuthenticated)
    {
        <form method="post" action="/Home/ToggleLike">
            @{
                var userId = int.Parse(User.FindFirstValue("userid"));
                var userLikedPost = post.Likes.Where(l => l.AppUserId == userId).Any();

                if (userLikedPost)
                {
                    <button class="btn btn-sm btn-danger" name="postId" value="@post.Id">Empfehlung entfernen</button>
                }
                else
                {
                    <button class="btn btn-sm btn-success" name="postId" value="@post.Id">Beitrag Empfehlen</button>
                }
            }
        </form>
    }
    <br />
}