@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="text-center mb-4">Login</h2>
                <form method="post" action="/Auth/Login">
                    <div class="mb-3">
                        <label class="form-label">Benutzername oder E-Mail</label>
                        <input name="userid" class="form-control" placeholder="E-Mail oder Username eingeben" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Passwort</label>
                        <input type="password" name="password" class="form-control" placeholder="Passwort eingeben" required />
                    </div>
                    <button class="btn btn-primary w-100 mt-3">Einloggen</button>
                </form>
            </div>
        </div>
    </div>
</div>